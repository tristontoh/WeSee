# Node — slash-less too, for the .nosync symlinks; see the root .gitignore.
node_modules/
node_modules
npm-debug.log
yarn-error.log
*.log

# Build output
dist/
dist
build/
coverage/

# Env — the API base URL and any keys are per-machine
.env*
!.env.example

# Playwright
/test-results/
/playwright-report/
/blob-report/

# IDEs and editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.history/*

# Throwaway browser probes. Two of these were committed by accident from another session, one
# of them carrying a local login — they are scratch, never source.
tmp-*.mjs

# System files
.DS_Store
Thumbs.db
