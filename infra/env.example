# Copy to infra/.env and fill in. That file is gitignored; this one is not, so never put a real
# value here.
#
#   cp infra/env.example infra/.env

# --- Required. The stack refuses to start without these, naming the one that is missing. ------

# The hostname this is served on. Caddy obtains a Let's Encrypt certificate for it, so it must
# already point at this server. Use localhost for a local smoke test (plain HTTP, no certificate).
DOMAIN=wesee.example.com

# Where Let's Encrypt writes about expiring certificates. A real address you read.
ACME_EMAIL=you@example.com

DB_NAME=wesee
DB_USERNAME=wesee
# openssl rand -base64 32
DB_PASSWORD=

# Signs every session token. At least 48 bytes — HMAC-SHA384.
# openssl rand -base64 48
JWT_SECRET=

# Document extraction. The application will not start without it.
GEMINI_API_KEY=

# What Prometheus presents to /actuator/prometheus. With this unset the metrics endpoints refuse
# everything, including Prometheus.
# openssl rand -hex 32
METRICS_SCRAPE_TOKEN=

# Grafana's admin password, for https://$DOMAIN/grafana/ (username: admin).
# openssl rand -base64 24
GRAFANA_PASSWORD=

# --- Email. Leave blank and no mail is sent, with nothing on screen to say so: every ----------
# --- invitation and every verification link silently fails. ------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@wesee.my

# --- Backups. The defaults keep 30 days on this machine, which does not survive this ----------
# --- machine. Set BACKUP_UPLOAD_CMD to get them somewhere else. --------------------------------

BACKUP_INTERVAL_HOURS=24
BACKUP_RETAIN_DAYS=30
BACKUP_HOST_DIR=./backups

# Run after each dump with the dump's path as $1. Install and configure rclone on the host first
# (rclone config), then mount its config into the backup service. Examples:
#   BACKUP_UPLOAD_CMD=rclone copy "$1" remote:wesee-backups
#   BACKUP_UPLOAD_CMD=aws s3 cp "$1" s3://your-bucket/wesee/
BACKUP_UPLOAD_CMD=
